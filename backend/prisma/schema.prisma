generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String                    @id @default(uuid())
  name                   String
  createdAt              DateTime                  @default(now())
  users                  User[]
  clients                Client[]
  cases                  Case[]
  caseTypes              CaseType[]
  tasks                  Task[]
  documents              Document[]
  calendar               CalendarEvent[]
  stages                 CaseStage[]
  auditLogs              AuditLog[]
  subscription           Subscription?
  permissions            OrganizationPermissions?
  documentTemplates      DocumentTemplate[]
  customFieldDefinitions CustomFieldDefinition[]
}

model OrganizationPermissions {
  id                            String       @id @default(uuid())
  organizationId                String       @unique
  organization                  Organization @relation(fields: [organizationId], references: [id])

  // Юристы видят только дела, назначенные на них (неназначенные дела видят все)
  lawyersSeeOnlyOwnCases        Boolean      @default(true)
  // Помощники видят только задачи, назначенные на них (неназначенные задачи видят все)
  assistantsSeeOnlyOwnTasks     Boolean      @default(true)
  // Скрывать раздел "Журнал аудита" и настройки команды от роли LAWYER на фронте
  hideAdminSectionsFromLawyers  Boolean      @default(true)
  // Кто может удалять дела: OWNER (только владелец) | ADMIN (владелец + админ)
  whoCanDeleteCases             String       @default("ADMIN")
  // Кто может удалять документы: OWNER | ADMIN | ALL (все роли)
  whoCanDeleteDocuments         String       @default("ADMIN")

  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt
}

model User {
  id                  String               @id @default(uuid())
  email               String
  password            String
  refreshToken        String?
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  role                String               @default("LAWYER")
  tasks               Task[]
  assignedCases       Case[]               @relation("CaseAssignedLawyer")
  auditLogs           AuditLog[]
  uploadedDocuments   Document[]            @relation("DocumentUploader")
  passwordResetTokens PasswordResetToken[]
  loginOtps           LoginOtp[]
  twoFactorEnabled    Boolean              @default(false)
  isPlatformAdmin     Boolean              @default(false)
  createdAt           DateTime             @default(now())

  @@index([organizationId])
  @@unique([organizationId, email])
}

model LoginOtp {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Client {
  id             String       @id @default(uuid())
  fullName       String
  phone          String?
  email          String?
  notes          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  cases          Case[]
  createdAt      DateTime     @default(now())

  // Значения настраиваемых полей клиента: { "<key из CustomFieldDefinition>": "значение" }.
  // Набор допустимых ключей и их типы описаны в CustomFieldDefinition (entityType = CLIENT).
  customFields   Json?

  @@index([organizationId])
  @@index([organizationId, fullName])
}

model CaseType {
  id                     String                   @id @default(uuid())
  name                   String
  description            String?
  organizationId         String
  organization           Organization             @relation(fields: [organizationId], references: [id])
  cases                  Case[]
  tasksTemplate          Json?
  documentsTemplate      Json?
  rules                  Json?
  createdAt              DateTime                 @default(now())

  // Собственная воронка стадий для этого типа дела (см. CaseStage.caseTypeId).
  // Если пусто — дела этого типа используют дефолтные стадии организации
  // (стадии с caseTypeId = null).
  stages                 CaseStage[]

  // Поля дела, специфичные именно для этого типа (например, "кадастровый номер"
  // только для "Сделка с недвижимостью"). Универсальные поля для всех типов
  // дел настраиваются с caseTypeId = null на CustomFieldDefinition.
  customFieldDefinitions CustomFieldDefinition[]

  @@index([organizationId])
  @@unique([organizationId, name])
}

model Case {
  id              String          @id @default(uuid())
  title           String
  description     String?
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  caseTypeId      String?
  caseType        CaseType?       @relation(fields: [caseTypeId], references: [id])
  stageId         String?
  stage           CaseStage?      @relation(fields: [stageId], references: [id])
  assignedLawyerId String?
  assignedLawyer  User?           @relation("CaseAssignedLawyer", fields: [assignedLawyerId], references: [id])
  tasks           Task[]
  documents       Document[]
  auditLogs       AuditLog[]
  calendarEvents  CalendarEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Процессуальный срок: либо фиксированная дата, либо авторасчёт
  // от даты события (deadlineSourceDate) + количество дней (deadlineDays).
  deadlineLabel           String?
  deadlineDate            DateTime?
  deadlineSourceDate      DateTime?
  deadlineDays            Int?
  deadlineReminderSentAt  DateTime?

  // Значения настраиваемых полей дела: { "<key>": "значение" }.
  // Автоматически доступны в шаблонах документов как {{custom.<key>}}.
  customFields            Json?

  @@index([organizationId])
  @@index([organizationId, title])
  @@index([deadlineDate])
}

model Task {
  id              String      @id @default(uuid())
  title           String
  description     String?
  status          String      @default("pending")
  dueDate         DateTime?
  completedAt     DateTime?
  assignedToId    String?
  assignedTo      User?       @relation(fields: [assignedToId], references: [id])
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  caseId          String
  case            Case        @relation(fields: [caseId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  auditLogs       AuditLog[]

  @@index([organizationId])
}

model Document {
  id              String       @id @default(cuid())
  organizationId  String
  caseId          String
  name            String
  fileUrl         String?
  mimeType        String?
  fileSize        Int?
  uploadedAt      DateTime     @default(now())
  uploadedById    String?
  type            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  case            Case         @relation(fields: [caseId], references: [id])
  uploadedBy      User?        @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([caseId])
  @@index([uploadedById])
}

model CalendarEvent {
  id              String       @id @default(uuid())
  title           String
  description     String?
  date            DateTime
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  caseId          String?
  case            Case?        @relation(fields: [caseId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([organizationId])
}

model CaseStage {
  id              String       @id @default(uuid())
  name            String
  order           Int
  color           String?      @default("#3B82F6")
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  cases           Case[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Если null — это дефолтная (общая) стадия организации, используется типами дел
  // без собственной воронки. Если указан — стадия принадлежит воронке конкретного
  // типа дела и видна/используется только в рамках него.
  // Уникальность order внутри группы (organizationId, caseTypeId) поддерживается
  // на уровне CaseStageService (транзакционный сдвиг), не через DB-констрейнт —
  // Postgres считает NULL уникальным для каждой строки, поэтому unique-индекс
  // с nullable caseTypeId не защитил бы дефолтную группу от дублей order.
  caseTypeId      String?
  caseType        CaseType?    @relation(fields: [caseTypeId], references: [id])

  @@index([organizationId])
  @@index([organizationId, caseTypeId])
  @@index([organizationId, caseTypeId, order])
}

model AuditLog {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  action          String
  entity          String
  entityId        String
  meta            Json?
  caseId          String?
  case            Case?        @relation(fields: [caseId], references: [id])
  taskId          String?
  task            Task?        @relation(fields: [taskId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([organizationId])
}

model DocumentTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  content        String       @db.Text
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// =========================
// НАСТРАИВАЕМЫЕ ПОЛЯ (клиент / дело)
// Владелец организации описывает набор полей под свою сферу деятельности
// (паспортные данные, ИНН, кадастровый номер, номер полиса и т.д.).
// Значения хранятся в Client.customFields / Case.customFields по полю `key`.
// Поля дела с key автоматически доступны в шаблонах как {{custom.key}}.
// =========================
model CustomFieldDefinition {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // "CLIENT" | "CASE"
  entityType     String

  // Ключ переменной, например "кадастровый_номер" -> {{custom.кадастровый_номер}}.
  // Уникален в рамках (organizationId, entityType).
  key            String

  // Отображаемое название поля в интерфейсе, например "Кадастровый номер"
  label          String

  // "TEXT" | "TEXTAREA" | "NUMBER" | "DATE" | "SELECT" | "BOOLEAN"
  fieldType      String       @default("TEXT")

  // Варианты для fieldType = SELECT: ["Вариант 1", "Вариант 2"]
  options        Json?

  required       Boolean      @default(false)
  order          Int          @default(0)

  // Только для entityType = CASE: если задан — поле показывается только
  // для дел этого типа. Если null — поле общее для всех типов дел организации.
  // Для entityType = CLIENT это поле игнорируется (клиенты не типизированы).
  caseTypeId     String?
  caseType       CaseType?    @relation(fields: [caseTypeId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, entityType])
  @@unique([organizationId, entityType, key])
}

model Plan {
  id             String         @id @default(uuid())
  key            String         @unique
  name           String
  description    String?
  priceMonthly   Int
  currency       String         @default("usd")
  maxUsers       Int?
  stripePriceId  String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[]
}

model Subscription {
  id                   String        @id @default(uuid())
  organizationId       String        @unique
  organization         Organization  @relation(fields: [organizationId], references: [id])
  planId               String?
  plan                 Plan?         @relation(fields: [planId], references: [id])
  status               String        @default("trialing")
  stripeCustomerId     String?
  stripeSubscriptionId String?       @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  manualOverride       Boolean       @default(false)
  overrideReason       String?
  overrideExpiresAt    DateTime?
  overrideGrantedBy    String?
  overrideGrantedAt    DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([stripeCustomerId])
}
