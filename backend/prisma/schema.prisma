generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

# =========================
# ORGANIZATION (multi-tenant core)
# =========================
model Organization {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())

  users       User[]
  clients     Client[]
  cases       Case[]
  caseTypes   CaseType[]
  tasks       Task[]
  documents   Document[]
  calendar    CalendarEvent[]
}

# =========================
# USER
# =========================
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  createdAt       DateTime @default(now())
}

# =========================
# CLIENT
# =========================
model Client {
  id              String   @id @default(uuid())
  fullName        String
  phone           String?
  email           String?
  notes           String?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  cases           Case[]

  createdAt       DateTime @default(now())
}

# =========================
# CASE TYPE (TEMPLATE ENGINE CORE)
# =========================
model CaseType {
  id              String   @id @default(uuid())
  name            String
  description     String?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  cases           Case[]

  // 🧠 TEMPLATE ENGINE (JSON)
  tasksTemplate     Json?
  documentsTemplate Json?

  createdAt       DateTime @default(now())
}

# =========================
# CASE
# =========================
model Case {
  id              String   @id @default(uuid())
  title           String
  description     String?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  clientId        String
  client          Client @relation(fields: [clientId], references: [id])

  caseTypeId      String?
  caseType        CaseType? @relation(fields: [caseTypeId], references: [id])

  tasks           Task[]
  documents       Document[]

  createdAt       DateTime @default(now())
}

# =========================
# TASK
# =========================
model Task {
  id              String   @id @default(uuid())
  title           String
  description     String?
  status          String @default("pending")

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  caseId          String
  case            Case @relation(fields: [caseId], references: [id])

  createdAt       DateTime @default(now())
}

# =========================
# DOCUMENT
# =========================
model Document {
  id              String   @id @default(uuid())
  name            String
  type            String?
  fileUrl         String?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  caseId          String
  case            Case @relation(fields: [caseId], references: [id])

  createdAt       DateTime @default(now())
}

# =========================
# CALENDAR EVENT
# =========================
model CalendarEvent {
  id              String   @id @default(uuid())
  title           String
  description     String?
  date            DateTime

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  caseId          String?
  case            Case? @relation(fields: [caseId], references: [id])

  createdAt       DateTime @default(now())
}
