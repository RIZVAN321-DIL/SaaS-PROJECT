generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

# =========================
# ORGANIZATION
# =========================
model Organization {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())

  users       User[]
  clients     Client[]
  cases       Case[]
  caseTypes   CaseType[]
  tasks       Task[]
  documents   Document[]
  calendar    CalendarEvent[]
  stages      CaseStage[]

  auditLogs   AuditLog[]
}

# =========================
# USER
# =========================
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  refreshToken    String?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  role            Role     @default(LAWYER)

  tasks           Task[]
  auditLogs       AuditLog[]

  createdAt       DateTime @default(now())
}

# =========================
# CLIENT
# =========================
model Client {
  id              String   @id @default(uuid())
  fullName        String
  phone           String?
  email           String?
  notes           String?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  cases           Case[]

  createdAt       DateTime @default(now())
}

# =========================
# CASE TYPE
# =========================
model CaseType {
  id              String   @id @default(uuid())
  name            String
  description     String?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  cases           Case[]

  tasksTemplate     Json?
  documentsTemplate Json?
  rules             Json?

  createdAt       DateTime @default(now())
}

# =========================
# CASE
# =========================
model Case {
  id              String   @id @default(uuid())
  title           String
  description     String?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  clientId        String
  client          Client @relation(fields: [clientId], references: [id])

  caseTypeId      String?
  caseType        CaseType? @relation(fields: [caseTypeId], references: [id])

  stageId         String?
  stage           CaseStage? @relation(fields: [stageId], references: [id])

  tasks           Task[]
  documents       Document[]
  auditLogs       AuditLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

# =========================
# TASK
# =========================
model Task {
  id              String   @id @default(uuid())

  title           String
  description     String?

  status          String   @default("pending")

  dueDate         DateTime?
  completedAt     DateTime?

  assignedToId    String?
  assignedTo      User? @relation(fields: [assignedToId], references: [id])

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  caseId          String
  case            Case @relation(fields: [caseId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditLogs       AuditLog[]
}

# =========================
# DOCUMENT
# =========================
model Document {
  id              String   @id @default(uuid())
  name            String
  type            String?
  fileUrl         String?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  caseId          String
  case            Case @relation(fields: [caseId], references: [id])

  createdAt       DateTime @default(now())
}

# =========================
# CALENDAR EVENT
# =========================
model CalendarEvent {
  id              String   @id @default(uuid())
  title           String
  description     String?
  date            DateTime

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  caseId          String?
  case            Case? @relation(fields: [caseId], references: [id])

  createdAt       DateTime @default(now())
}

# =========================
# CASE STAGE
# =========================
model CaseStage {
  id              String   @id @default(uuid())

  name            String
  order           Int

  color           String?  @default("#3B82F6")

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  cases           Case[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

# =========================
# AUDIT LOG
# =========================
model AuditLog {
  id              String   @id @default(uuid())

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  userId          String
  user            User @relation(fields: [userId], references: [id])

  action          String
  entity          String
  entityId        String

  meta            Json?

  caseId          String?
  case            Case? @relation(fields: [caseId], references: [id])

  taskId          String?
  task            Task? @relation(fields: [taskId], references: [id])

  createdAt       DateTime @default(now())
}

# =========================
# ROLES ENUM
# =========================
enum Role {
  OWNER
  ADMIN
  LAWYER
  ASSISTANT
}
